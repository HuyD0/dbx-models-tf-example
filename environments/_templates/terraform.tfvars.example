# NOTE: this file is tracked in git as a safe template.
# Copy to terraform.tfvars and fill in real values (terraform.tfvars is gitignored).
# See scripts/new-team.sh to scaffold a new team directory automatically.

location               = "canadacentral"
resource_group_name    = "rg-databricks-ENV_NAME-TEAM_NAME"
workspace_name         = "dbw-ENV_NAME-TEAM_NAME"
sku                    = "premium"
vnet_cidr              = "10.200.0.0/20"   # CHANGE: pick a non-overlapping /20

uc_storage_account_name = "dbwENVTEAMuc"   # CHANGE: 3-24 lowercase alphanumeric

ai_foundry_name           = "aif-myorg-ENV_NAME"
ai_foundry_resource_group = "rg-aifoundry-ENV_NAME"
openai_api_version        = "2024-12-01-preview"

inference_table_catalog = "llmlogs_ENV_NAME"
inference_table_schema  = "model_serving_logs"

model_serving_fallback_enabled             = true
model_serving_endpoint_permissions_enabled = false
model_serving_rate_limits = [
  { calls = 60, key = "endpoint", renewal_period = "minute" },
  { calls = 20, key = "user",     renewal_period = "minute" },
]

model_serving_admin_groups  = ["ad-dbx"]
workspace_groups            = ["ad-dbx-TEAM_NAME"]
consumer_groups             = []
contributor_group_object_id = "<aad-group-object-id>"  # CHANGE

deployment_sp_client_id = "<YOUR_DEPLOYMENT_SP_CLIENT_ID>"  # sp-terraform-databricks

# Required — supply via TF_VAR_* env vars in CI (never commit real values):
# subscription_id       = "<uuid>"
# databricks_account_id = "<uuid>"
# metastore_id          = "<uuid>"

tags = {
  environment      = "ENV_NAME"
  team             = "TEAM_NAME"
  managed_by       = "terraform"
  data_sensitivity = "public"
  owner            = "ad-dbx-TEAM_NAME"
  cost-center      = "TEAM_NAME"
  shortcode        = "aiml"
}
