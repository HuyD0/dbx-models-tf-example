# Local Terraform state (never commit)
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# NOTE: .terraform.lock.hcl SHOULD be committed (provider version pinning).

# Terraform plan files (may contain sensitive data)
tfplan
tfplan-*
*.tfplan

# Variable files with sensitive values — keep examples committed
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config (contains real storage account name) — keep examples committed
backend.hcl
!backend.hcl.example

# Terraform overrides (used for local-only experimentation)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local dev secrets — never commit
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
.idea/
.vscode/
