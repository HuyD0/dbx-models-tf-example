# Local Terraform state (never commit)
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# NOTE: .terraform.lock.hcl SHOULD be committed for ROOT modules (envs,
# bootstrap, examples) — provider version pinning. Locks inside modules/
# are ignored (Terraform only honors the root's lock when a module is
# consumed) — EXCEPT model-serving, which acts as its own root for
# `terraform test`, so its lock is committed to pin the test providers.
modules/**/.terraform.lock.hcl
!modules/model-serving/.terraform.lock.hcl

# Terraform plan files (may contain sensitive data)
tfplan
tfplan-*
*.tfplan

# Variable files with sensitive values — keep examples committed
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config (contains real storage account name) — keep examples committed
backend.hcl
!backend.hcl.example

# Terraform overrides (used for local-only experimentation)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local dev secrets — never commit
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
.idea/
.vscode/
