# Copy this file to .env and fill in real values (.env is gitignored).
#
# Get values after running: cd bootstrap && terraform apply
#   ARM_CLIENT_ID     → terraform output -raw sp_client_id
#   ARM_CLIENT_SECRET → az keyvault secret show --vault-name <YOUR_KV_NAME> \
#                         --name terraform-sp-secret --query value -o tsv
#
# Usage: source .env

ARM_CLIENT_ID="<sp-app-id>"
ARM_CLIENT_SECRET="<from-key-vault>"
ARM_TENANT_ID="<aad-tenant-id>"
ARM_SUBSCRIPTION_ID="<subscription-id>"

ARM_USE_OIDC="false"
ARM_USE_AZUREAD="true"

DATABRICKS_ACCOUNT_ID="<databricks-account-id>"

# Databricks account-admin SP — used exclusively by the `accounts` provider alias
# for metastore assignment + group/permission APIs. Must hold account-admin role
# in the Databricks account console. Keep separate from the deployment SP (ARM_CLIENT_ID)
# so the deployment SP does not need account-admin privileges.
#   TF_VAR_dbx_account_admin_client_id     → az keyvault secret show --vault-name <YOUR_KV_NAME> \n#                                               --name dbx-account-admin-client-id --query value -o tsv
#   TF_VAR_dbx_account_admin_client_secret → az keyvault secret show --vault-name <YOUR_KV_NAME> \n#                                               --name dbx-account-admin-client-secret --query value -o tsv
TF_VAR_dbx_account_admin_client_id="<account-admin-sp-app-id>"
TF_VAR_dbx_account_admin_client_secret="<account-admin-sp-secret>"
