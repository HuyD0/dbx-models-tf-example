# Copy this file to terraform.tfvars and fill in your values.

location             = "eastus2"
resource_group_name  = "rg-databricks-dbx-dev"
workspace_name       = "dbx-dev"
sku                  = "premium"
vnet_cidr            = "10.192.0.0/20"
no_public_ip         = true
public_network_access_enabled     = true
infrastructure_encryption_enabled = true

ai_foundry_name           = "aif-my-account"
ai_foundry_resource_group = "rg-aifoundry"
openai_api_version        = "2024-12-01-preview"
inference_table_catalog   = "main"
inference_table_schema    = "model_serving_logs"

tags = {
  environment      = "dev"
  managed_by       = "terraform"
  data_sensitivity = "public"
  shortcode        = "aiml"
}

# Budget (serverless usage) policy for endpoint cost attribution — from:
#   cd environments/account && terraform output budget_policy_ids
# model_serving_budget_policy_id = "00000000-0000-0000-0000-000000000000"

# Scheduled SQL alerts that surface silent agent waste — retry loops,
# elevated error rates, callers hammering blocked models and (opt-in)
# sessions repeatedly feeding tool errors back to the model. See
# docs/agent-spend-waste.md. Needs a SQL warehouse ID; turn on
# payload_alerts_enabled only after the inference tables exist (first traffic).
# model_serving_agent_waste_monitors = {
#   warehouse_id           = "1234567890abcdef"
#   notify_emails          = ["mlops-team@example.com"]
#   payload_alerts_enabled = false
# }
