# Copy this file to terraform.tfvars and fill in your values.

location             = "eastus2"
resource_group_name  = "rg-databricks-dbx-dev"
workspace_name       = "dbx-dev"
sku                  = "premium"
vnet_cidr            = "10.192.0.0/20"
no_public_ip         = true
public_network_access_enabled     = true
infrastructure_encryption_enabled = true

ai_foundry_name           = "aif-my-account"
ai_foundry_resource_group = "rg-aifoundry"
openai_api_version        = "2024-12-01-preview"
inference_table_catalog   = "main"
inference_table_schema    = "model_serving_logs"

tags = {
  environment      = "dev"
  managed_by       = "terraform"
  data_sensitivity = "public"
  shortcode        = "aiml"
}

# Budget (serverless usage) policy for endpoint cost attribution — from:
#   cd environments/account && terraform output budget_policy_ids
# model_serving_budget_policy_id = "00000000-0000-0000-0000-000000000000"
